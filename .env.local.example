# MongoDB connection string (MongoDB Atlas or local instance)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/loteca?retryWrites=true&w=majority
MONGODB_URI=

# Google OAuth credentials (Auth.js v5 / next-auth)
# Obtain from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=
